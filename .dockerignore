# Docker ignore file for Java Maven project
# Exclude build artifacts and unnecessary files from Docker context

# Maven build artifacts
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Maven wrapper files (CRITICAL: Always use system mvn, not wrapper)
mvnw
mvnw.cmd
.mvn/

# Gradle wrapper files (CRITICAL: Always use system gradle, not wrapper)
gradlew
gradlew.bat
gradle/wrapper/
.gradle/
build/

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Git files
.git/
.gitignore
.gitattributes

# Documentation and non-runtime files
*.md
README*
LICENSE*
CONTRIBUTING*
CODEOWNERS
docs/
documentation/

# Test files
src/test/
**/test/
**/*Test.java
**/*Tests.java

# Log files
*.log
logs/

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Docker files (don't copy Docker files into image)
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD files
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile
azure-pipelines.yml

# Migration and analysis files
migration-bundle/
analysis/
reports/

# Environment files
.env
.env.*
*.env
