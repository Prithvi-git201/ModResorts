# Docker ignore file for ModResorts Java application
# Exclude build artifacts and unnecessary files from Docker context

# Maven build artifacts
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Maven wrapper files (CRITICAL: exclude these)
mvnw
mvnw.cmd
.mvn/

# Gradle build artifacts
build/
.gradle/
gradle-app.setting
!gradle-wrapper.jar
.gradletasknamecache

# Gradle wrapper files (CRITICAL: exclude these)
gradlew
gradlew.bat
gradle/wrapper/

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Git files
.git/
.gitignore
.gitattributes

# Documentation and non-essential files
*.md
README*
LICENSE
CONTRIBUTING*
CODEOWNERS
docs/
documentation/

# Test files
src/test/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Docker files (don't copy Docker files into the image)
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD files
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile
azure-pipelines.yml

# Migration and analysis files
migration-bundle/
analysis/
reports/

# Environment files
.env
.env.*
*.env

# Backup files
*.bak
*.backup
