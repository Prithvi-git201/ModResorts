# ModResorts Environment Configuration Template
# Copy this file to .env and update with your AWS values

# Server Configuration
PORT=8080

# Database Configuration (Amazon RDS)
DB_URL=jdbc:postgresql://your-rds-endpoint.region.rds.amazonaws.com:5432/modresorts
DB_USERNAME=modresorts
DB_PASSWORD=<retrieve-from-secrets-manager>
DB_DRIVER=org.postgresql.Driver
DB_POOL_SIZE=10
DB_MIN_IDLE=2

# Redis Configuration (Amazon ElastiCache)
REDIS_HOST=your-elasticache-endpoint.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=<retrieve-from-secrets-manager>
REDIS_SSL=true

# AWS Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=modresorts-data

# Weather API Key (Optional - can use Secrets Manager instead)
# WEATHER_API_KEY=your-weather-api-key

# AWS Secrets Manager Secret Names
# - modresorts/weather-api-key: Weather Underground API key
# - modresorts/db-password: Database password
# - modresorts/redis-password: Redis password

# Spring Profile
SPRING_PROFILES_ACTIVE=production
